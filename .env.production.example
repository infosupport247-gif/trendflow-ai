APP_ENV=production
APP_DOMAIN=app.example.com
CORS_ORIGINS=https://app.example.com
POSTGRES_USER=trendflow
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM
POSTGRES_DB=trendflow
DATABASE_URL=postgresql+psycopg://trendflow:REPLACE_WITH_RANDOM@postgres:5432/trendflow
REDIS_PASSWORD=REPLACE_WITH_RANDOM
REDIS_URL=redis://:REPLACE_WITH_RANDOM@redis:6379/0
JWT_SECRET=REPLACE_WITH_RANDOM
TOKEN_VAULT_KEY=REPLACE_WITH_FERNET_KEY
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM
S3_ACCESS_KEY=trendflowadmin
S3_SECRET_KEY=REPLACE_WITH_RANDOM
S3_BUCKET=trendflow-assets
S3_PUBLIC_BASE_URL=https://app.example.com/assets
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
AUTONOMY_INTERVAL_SECONDS=3600
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM
PROMETHEUS_RETENTION_DAYS=15d